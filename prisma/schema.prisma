// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
}

model User {
    id String @id
    username String @unique
    score Int @default(0)
}

model Update {
    id String @id
    timestamp DateTime @default(now())
    log String
}